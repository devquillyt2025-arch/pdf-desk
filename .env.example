# Copy to .env (never commit .env). These are read by the server functions in api/ only —
# do not prefix them with VITE_, or they would be shipped to every visitor's browser.

# Neon connection string (Neon console → Connect → the pooled one)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# The one secret that unlocks the cloud library. At least 8 characters; longer is better.
APP_PASSCODE=change-me-to-a-long-random-passcode

# Optional
# DB_SCHEMA=pagedesk        # where the tables live (lower-case letters, digits, _)
# MAX_LIBRARY_MB=400        # refuse new uploads beyond this much stored PDF data
